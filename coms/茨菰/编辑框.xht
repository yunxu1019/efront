<style>
    & {
        overflow: hidden;
        border-top: 0;
        border-bottom: 0;
        display: block;
        padding: 0;
        max-height: 100%;
        min-height: 6em;
    }

    &.noinput {
        &:before {
            position: absolute;
            background: #c24;
            color: #fff;
            left: 0;
            right: 0;
            top: 0;
            height: 20px;
            line-height: 20px;
            font-size: 16px;
            display: block;
            content: "当前浏览器编辑会造成异常";
        }
    }

    @ntype(@len) {

        &[ntype="@{len}"] {
            @w: @len/2+1.4;
            @bg: --bgcolor;

            >[nlist],
            >[clist] {
                display: inline-block;
                vertical-align: top;
                outline: none;
            }

            >[clist] {
                background: #2c2d2c;
                margin-left:-@{w}em;
                border-left: @{w}em solid transparent;
                width: 100%;
                overflow-x: hidden;
            }

            >[nlist] {
                z-index: 1;
                width: @{w}em;
                text-align: right;
                padding-right: .6em;
                color: #666;
                position: relative;
            }
        }
    }

    @ntype(0);
    @ntype(1);
    @ntype(2);
    @ntype(3);
    @ntype(4);
    @ntype(5);
    @ntype(6);
    @ntype(7);

    >list {
        display: inline-block;
        min-height: 100%;
        border-top: 6px solid #2c2d2c;

        &[nlist] {
            background: #222;
            border-color: #222;
        }

        &[clist] {
            border-right: 2px solid transparent;
        }

        >d {
            outline: none;
            border: none;

            &:after {
                content: "";
                pointer-events: none;
                user-select: none;
                display: inline-block;
                width: 16px;
            }

            &:focus {
                outline: 1px solid #fff3;
            }
        }

        >n[current] {
            color: #ccc;
        }

        >n,
        >d {
            display: block;
            height: 1.36em;
        }
    }

    >scrollbar {
        right: 0;
        left: auto !important;
        position: fixed;
    }
</style>
<编辑框 spellcheck=false e-class="上色.className" e-style="{whiteSpace:'pre'}" ntype:="codeSpan">
    <list contenteditable="false" nlist# :src="(r,i) in coderows" -style="{height:codeHeight}">
        <n current:="isCurrent(i)" -bind="i+1"></n>
    </list>
    <list clist# body contenteditable:="contenteditable" :src="(r,i) in coderows" -style="{height:codeHeight}">
        <d -html="r"></d>
    </list>
    <scrollbar x></scrollbar>
    <scrollbar y :target="this.parentNode"></scrollbar>
</编辑框>
<script>
    var coder = this;
    onmousewheel(this, function (event) {
        if (!event.shiftKey) return;
        event.preventDefault();
        clist.scrollLeft += event.deltaY;
    });
    vbox(this);
    var contenteditable = !this.readonly;
    watch(coder, {
        readonly(v) {
            contenteditable = !v;
        }
    })
    if (!('oninput' in document)) {
        on('focus')(this, function () {
            if (this.contentEditable) addClass(this, "noinput");
        });
        on('blur')(this, function () {
            removeClass(this, 'noinput');
        })
    }
    var codeHeight = '';
    var codeSpan = 1;
    var coderid = 0;
    care(coder, async function ([text, type]) {
        try {
            coder.type = type;
            await coder.setValue(text);
        } catch {
            if (typeof text === 'string') coder.innerHTML = 渲染.encode(text);
        }
    });
    var reshape = function () {
        codeHeight = coderows.length * 1.36 + 2;
        if (codeHeight < 6) codeHeight = 6;
        codeHeight += 'em';
        codeSpan = (coderows.length).toString().length;
    };
    on('scroll')(coder, function () {
        nlist.refresh();
        clist.refresh();
    });
    var isCurrent = function (i) {
        if (!selection) return false;
        return i >= selection[0] && i <= selection[2];
    };
    var coderows = [""], codetext = '';
    coder.setValue = async function (text) {
        codetext = text;
        var id = ++coderid;
        var colored = 上色.rows(this.type, text);
        if (id !== coderid) return;
        coderows = colored;
        codeHistory = [[codetext]];
        historyIndex = 0;
        reshape();
        render.refresh(coder);
    };
    coder.getValue = function () {
        return codetext;
    };
    var selection;
    var markAnchorOffset = function () {
        selection = getSelection();
        render.refresh(nlist);
    };
    var spacing = false;
    var isEqual = function (a, b) {
        return a === b || !a && !b;
    };
    var getNodeText = function (node) {
        if (!node) return '';
        if (node.nodeType === 3) return node.nodeValue;
        if (node.nodeType === 1) return node.innerText;
        return '';
    }
    var getNodeAt = function (row, col) {
        var d = clist.at(row);
        if (!d) return [];
        var c = d.firstChild;
        if (!spacing) {
            var t = d.innerText;
            var tbb = t.charAt(col - 3);
            var tb = t.charAt(col - 2);
            var ta = t.charAt(col - 1);
            var tf = t.charAt(col);
            var tff = t.charAt(col + 1);
            if (ta === " " && isEqual(tb, anchorChar)) {
                col++;
            }
            else if (anchorChar && tb && isEqual(ta, anchorChar) && !isEqual(tb, anchorChar)) {
                col++;
            }
            else if (anchorChar === " " && isEqual(ta, followChar) && !isEqual(tf, followChar)) {
                col--;
            }
        }
        var inc = 0;
        while (c) {
            if (c.nodeType === 1) {
                var t = c.innerText;
                var tl = t.length;
                if (inc + tl >= col) {
                    c = c.firstChild;
                    continue;
                }
                inc += tl;
                c = c.nextSibling;
            }
            else if (c.nodeType === 3) {
                var t = c.nodeValue;
                var tl = t.length;
                if (inc + tl > col) {
                    col -= inc;
                    inc = 0;
                    break;
                }
                else if (inc + tl === col) {
                    break;
                }
                inc += tl;
                c = c.nextSibling;
            }
        }
        if (!c) return [d, d.childNodes.length];
        return [c, col - inc];
    }
    var anchor = document.createElement('span');
    var unmarkAnchorOffset = function () {
        if (!selection) return;
        var [an, ai, fn, fi] = selection;
        [fn, fi] = getNodeAt(fn, fi);
        [an, ai] = fn === an && fi === ai ? [fn, fi] : getNodeAt(an, ai);
        if (an && an === fn && ai === fi) {
            var d = getTargetIn(clist, an, false);
            if (an === d) {
                d.insertBefore(anchor, d.childNodes[ai]);
            }
            else {
                an.parentNode.insertBefore(anchor, an.nextSibling);
            }
            if (anchor.offsetLeft > clist.clientWidth + clist.scrollLeft + d.offsetLeft) {
                clist.scrollLeft = anchor.offsetLeft - clist.clientWidth + 6;
            }
            else if (anchor.offsetLeft < clist.scrollLeft) {
                clist.scrollLeft = anchor.offsetLeft;
            }
            anchor.parentNode.removeChild(anchor);
            if (d.offsetTop < coder.scrollTop + clist.offsetTop) {
                coder.scrollTop = d.offsetTop - clist.offsetTop;
            }
        }
        if (an && fn) document_selection.setBaseAndExtent(an, ai, fn, fi);
    }
    var trimspace = (_, a) => a ? "" : " ";
    var 更新 = function () {
        var { scrollTop, scrollLeft } = clist;
        reshape();
        render.refresh(coder);
        clist.scrollTop = scrollTop;
        clist.scrollLeft = scrollLeft;
    };
    var anchorChar = null, inText = false;
    var followChar = null, beforeText = false;
    var fixpace = function (event) {
        spacing = true;
        event.preventDefault();
        insertText(' ', false);
        markAnchorOffset();
        unmarkAnchorOffset();
        spacing = false;
    };
    var updatechar = function (event) {
        if (event.defaultPrevented) return;
        anchorChar = "";
        followChar = '';
        coderid++;
        var { anchorNode, anchorOffset } = document_selection;
        if (!coder || !anchorNode) return;
        while (anchorNode.nodeType === 1 || anchorOffset === 0) {
            if (anchorNode.nodeType === 1) {
                var { childNodes } = anchorNode;
                if (childNodes.length > 0) {
                    if (anchorOffset >= childNodes.length) {
                        anchorNode = anchorNode.lastChild;
                        if (anchorNode.nodeType === 1) anchorOffset = anchorNode.childNodes.length;
                        else anchorOffset = anchorNode.nodeValue.length;
                    }
                    else {
                        anchorNode = childNodes[anchorOffset];
                        anchorOffset = 0;
                    }
                }
                else {
                    anchorNode = anchorNode.previousSibling;
                    if (!anchorNode) return;
                    if (anchorNode.nodeType === 1) anchorOffset = anchorNode.childNodes.length;
                    else anchorOffset = anchorNode.nodeValue.length;
                }
            }
            if (anchorOffset === 0) {
                anchorNode = anchorNode.previousSibling || anchorNode.parentNode.previousSibling;
                do {
                    if (!anchorNode) return;
                    if (anchorNode.nodeType === 1) {
                        if (anchorNode.lastChild) {
                            anchorOffset = anchorNode.childNodes.length;
                        }
                        else {
                            anchorNode = anchorNode.previousSibling;
                        }
                    }
                    else {
                        if (anchorNode.nodeValue) {
                            anchorOffset = anchorNode.nodeValue.length;
                            break;
                        }
                        else {
                            anchorNode = anchorNode.previousSibling || anchorNode.parentNode.previousSibling;
                        }
                    }
                } while (anchorChar?.nodeType === 3 || anchorOffset === 0);
            }
            if (!anchorNode) return;
        }
        if (anchorNode.nodeType === 3) {
            inText = /^text$/i.test(anchorNode.parentNode.tagName);
            beforeText = inText;
            if (anchorOffset > 0) {
                anchorChar = anchorNode.nodeValue.charAt(anchorOffset - 1);
            }
            else {
                anchorChar = '';
            }
            if (anchorOffset >= anchorNode.nodeValue.length) {
                followChar = anchorNode.nextSibling || anchorNode.parentNode.nextSibling;
                if (!followChar) followChar = '';
                else if (followChar.nodeType === 1) {
                    beforeText = /^text$/i.test(followChar.tagName);
                    followChar = followChar.innerText.charAt(0);
                }
                else if (followChar.nodeType === 3) {
                    beforeText = /^text$/i.test(followChar.parentNode.tagName);
                    followChar = followChar.nodeValue.charAt(0);
                }
                else {
                    followChar = '';
                }
            }
            else {
                followChar = anchorNode.nodeValue.charAt(anchorOffset);
            }

        }
        else {
            inText = false;
            beforeText = false;
            followChar = '';
        }
    };
    var pairsmap = Object.create(null);
    [
        `""`,
        "''",
        '``',
        "()",
        "[]",
        "{}",
    ].forEach(a => {
        var [k, p] = a.split('');
        pairsmap[k] = p;
    });
    var codeHistory = [[""]];
    var historyIndex = 0;
    var getRow = function (node) {
        var d = getTargetIn(clist, node, false);
        if (!d) return;
        var i = d.i;
        if (isFinit(i)) return i;
        if (d.previousSibling) i = d.previousSibling.i + 1;
        else if (d.nextSibling) i = d.nextSibling.i - 1;
        return i;
    };
    var getCol = function (node, offset) {
        var d = getTargetIn(clist, node, false);
        if (!d) return;
        if (node.nodeType === 1) {
            var childNodes = node.childNodes;
            if (offset < childNodes.length) {
                node = childNodes[offset];
                offset = 0;
            }
            else {
                offset = node.innerText.length;
                node = null;
            }
        }
        while (node && node !== d) {
            var p = node.previousSibling;
            if (p) {
                if (p.nodeType === 1) {
                    offset += p.innerText.length;
                }
                else if (p.nodeType === 3) {
                    offset += p.nodeValue.length;
                }
                node = p;
                continue;
            }
            node = node.parentNode;
        }
        return offset;
    };
    var getFocusRow = function () {
        var { focusNode } = document_selection;
        return getRow(focusNode);
    };
    var getSelection = function () {
        var { focusNode, anchorNode, focusOffset, anchorOffset } = document_selection;
        var fn = getRow(focusNode);
        var an = anchorNode === focusNode ? fn : getRow(anchorNode);
        var fi = getCol(focusNode, focusOffset);
        var ai = anchorNode == focusNode && anchorOffset === focusOffset ? fi : getCol(anchorNode, anchorOffset);
        if (fn === an) {
            if (ai > fi) [ai, fi] = [fi, ai];
        }
        else if (an > fn) {
            [fn, an] = [an, fn];
        }
        return [an, ai, fn, fi];
    };
    var updatecode = function (event) {
        var { data, inputType } = event;
        var patchAfter = '';
        switch (inputType) {
            case "insertText":
                if (data === ' ') return false;
                if (anchorChar in pairsmap) {
                    if (followChar === pairsmap[anchorChar] && data === followChar) {
                        document.execCommand('forwardDelete');
                    }
                    else if (data in pairsmap) {
                        if (inText && anchorChar) {
                            if (/^'/.test(data)) return;
                        }
                        patchAfter = pairsmap[data];
                    }
                }
                else {
                    if (data in pairsmap) {
                        if (inText && anchorChar) {
                            if (/^'/.test(data)) return;
                        }
                        patchAfter = pairsmap[data];
                    }
                }
                spacing = false;
                break;
            case "insertParagraph":
                var i = getFocusRow();
                tab(clist, false);
                return;
            case "deleteContentForward": return;
            case "deleteContentBackward":
                if (anchorChar in pairsmap && followChar === pairsmap[anchorChar]) {
                    document.execCommand('forwardDelete');
                }
                return;

        }
        if (patchAfter) {
            insertText(patchAfter, true);
            followChar = patchAfter;
            markAnchorOffset();
        }
        return patchAfter;
    };
    var document_selection = document.getSelection();
    var isInput = false;
    var insertText = function (text, isPatch) {
        isInput = true;
        markAnchorOffset();
        var [an, ai, fn, fi] = selection;
        var [n, i] = getNodeAt(fn, fi);
        var d = 0;
        if (n.nodeType === 1) {
            n.insertBefore(document.createTextNode(text), n.childNodes[i + 1]);
            if (!isPatch) d = 1;
        }
        else if (n.nodeType === 3) {
            var v = n.nodeValue;
            n.nodeValue = v.slice(0, i) + text + v.slice(i);
            if (!isPatch) d = text.length;
        }
        if (d) {
            selection[3] += d;
            if (ai === fi) selection[1] += d;
        }
        if (an === fn && ai === fi) {
            i += d;
            document_selection.setBaseAndExtent(n, i, n, i);
        }
        else {
            [an, ai] = getNodeAt(an, ai);
            document_selection.setBaseAndExtent(an, ai, n, i + d);
        }
        markAnchorOffset();
    }
    var removeEndBR = function (d) {
        var e = d.lastChild;
        while (e) {
            if (e.tagName === 'BR') {
                remove(e);
                return;
            }
            e = e.lastChild;
        }
    };
    var patchRows = function (rows, k) {
        var ds = clist.children;
        ds = Array.apply(null, ds);
        ds.forEach(removeEndBR);
        var marked = ds.map(d => {
            return d[k]
        });
        var i = clist.start;
        var e = clist.end;
        rows.splice(i, e - i, ...marked);
    }
    var getCodeText = function () {
        var rows = codetext.split(/\r\n|\r|\n/);
        patchRows(rows, 'innerText');
        return rows.join('\r\n');
    };
    var updateCodeHtml = function () {
        patchRows(coderows, "innerHTML");
    };
    var keytab = function (direction) {
        tab(clist, direction);
        markAnchorOffset();
        pudo();
    };
    on("input")(coder, function (event) {
        if (event.isComposing) return;
        isInput = true;
        var id = ++coderid;
        spacing = true;
        var patch = updatecode(event);
        if (patch == null) {
            if (id !== coderid) return;
            // codetext = getCodeText();
            updateCodeHtml();
            pudo();
            更新();
            unmarkAnchorOffset();
            return;
        }
        if (id !== coderid) return;
        pudo();
        coderows = 上色.rows(coder.type, codetext);
        更新();
        unmarkAnchorOffset();
        coderows.forEach(function (c, i) {
            var d = c.indexOf(光标);
            if (d > 0) coderows[i] = c.slice(0, d) + c.slice(d + 1);
        });
    });
    on('keydown.space.only')(coder, fixpace);
    on('keydown.tab.shift.prevent.only')(coder, function () {
        keytab(-1);
    });
    on('keydown.tab.prevent.only')(coder, function () {
        keytab(1);
    });
    bind('selectionchange', document)(coder, function () {
        if (isInput) return isInput = false;
        markAnchorOffset();
    });
    var updo = function () {
        [codetext, selection] = codeHistory[historyIndex];
        coderows = 上色.rows(coder.type, codetext);
        更新();
        unmarkAnchorOffset();
        codetext = getCodeText();
    };
    var pudo = function (markedText) {
        markAnchorOffset();
        codetext = getCodeText();
        historyIndex++;
        codeHistory.splice(historyIndex, codeHistory.length - historyIndex);
        if (historyIndex > 6000) {
            codeHistory.splice(0, 1000);
            historyIndex -= 1000;
        }
        codeHistory.push([codetext, selection]);
        return;
    };
    var undo = function () {
        if (historyIndex > 0) {
            historyIndex--;
            updo();
        }
    };
    var redo = function () {
        if (historyIndex + 1 < codeHistory.length) {
            historyIndex++;
            updo();
        }
    };
    on('keydown.ctrl.z.prevent.only')(coder, undo);
    on('keydown.ctrl.shift.z.prevent.only')(coder, redo);
    on('keydown.ctrl.y.prevent.only')(coder, redo);
    on('keydown.backspace')(coder, function (event) {
        var { firstChild, lastChild } = clist;
        if (firstChild === lastChild && !firstChild.childNodes.length) {
            event.preventDefault();
            return;
        }
    });
    on('keydown')(coder, updatechar);
    reshape();
</script>