<style>
    &>select {
        background: inherit;
        vertical-align: top;
        color: inherit;
        margin-left: -2px;
        padding-left: 2px;
    }
</style>
<template>
    <select -model="i18n.getIndex,i18n.setIndex" title:="title()" -src="(s,i) in i18n.supports">
        <option -value="i" -bind="s.land===s.name?'🌏'+s.land:'🌐'+s.land +' - '+s.name"></option>
    </select>
</template>
<script>
    var title = () => i18n`切换语言`;
</script>