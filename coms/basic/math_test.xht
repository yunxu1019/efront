<p>
    <h2>
        秦九韶-海伦公式
    </h2>
    <div>
        ${math`S=sqrt(p*(p-a)*(p-b)*(p-c))`}
    </div>
</p>
<p>
    <h2>
        勾股定理
    </h2>
    <div>
        ${math`a**2+b**2=c**2`}
    </div>
</p>
<p>
    <h2>
        约分
    </h2>
    <div>
        ${
        math`(a/b/c)*(b/d)=a/(c*d)`
        }
    </div>
</p>
<p>
    <h2>
        极限
    </h2>
    <div>
        ${
        math`limit(a**-n,n,+Infinity)`
        }
    </div>
</p>
<p>
    ${
        math`cos(theta,2)*E+(1 - cos(theta))*K'*K+sin(theta)*[0,-K_2,K_1;K_2,0,-K_0;-K_1,K_0,0]`
    }

</p>
