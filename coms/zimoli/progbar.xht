<style>
    & {
        outline-offset: -3px;
        outline: 1px solid #3ae;
        display: inline-block;
        min-width: 60px;
        height: 14px;
        border: 1px solid;
        background: #eee1;
        position: relative;
        border-radius: 4px;
        overflow: hidden;
        white-space: nowrap;
        cursor: pointer;
    }

    &[danger] {
        outline: 1px solid #c24;

        >[value] {
            color: #c243;
            @pending(#c24, #fff);
        }
    }

    >div {
        vertical-align: top;
        display: inline-block;
        position: relative;
        border-top: 11px solid;
        border-bottom: 1px solid;
        height: 100%;

        &:first-child {
            border-radius: 4px 0 0 4px;
        }
    }

    @import "pending.less";

    >[value] {
        @pending(#0004, #fff3);
        background-position-x: right;
        background-clip: border-box;
        color: #3ae2;

        &:last-child {
            border-radius: inherit;
        }
    }

    >[state] {
        background-clip: content-box;
        background-color: #6ca;
    }

    >span {
        position: absolute;
        display: block;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 1;
        text-align: center;
        right: 0;
    }
</style>
<div>
    <span #text></span>
    <div value -style="{width:value}"></div>
    <div state -repeat="(s,i) in state" -style="{width:s,color:color.rotate('#f003',i)}"></div>
</div>
<script>
    var { total, current, pending = [] } = this;
    var calc = function (current) {
        var v = (current / total * 10000 + .5) | 0;
        if (v < 0) v = 0;
        if (v > 10000) v = 10000;
        return v / 100 + "%";
    };
    var calcAll = function (pending) {
        var res = [].concat(pending);
        var s = sum(res);
        res = res.map(calc);
        res.summary = calc(s);
        return res;
    };
    var state = calcAll(pending);
    var value = calc(current);
    Object.defineProperties(this, {
        innerText: {
            set(v) {
                text.innerText = v;
            },
            get() {
                return text.innerText;
            },
        },
        pending: {
            set(v) {
                pending = v;
                state = calcAll(pending);
            },
            get() {
                return pending;
            }
        },
        total: {
            set(v) {
                if (total === v) return;
                total = v;
                value = calc(current);
                state = calcAll(pending);
            },
            get() {
                return total;
            }
        },
        current: {
            set(v) {
                if (current === v) return;
                current = v;
                value = calc(current);
            },
            get() {
                return current;
            }
        }
    })
</script>