<style>
    & {
        position: absolute;
        width: 100%;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
        display: block;
        text-align: center;
    }

</style>
<div>
    <i18n-chooser style="float: left;"></i18n-chooser>
    <a @click="logout" -bind="exitLabel()"></a>
</div>

<script>
    var a = button;
    var exitLabel = () => i18n`退出登录`;
    async function logout() {
        data.setSource({});
        await user.Logout();
        zimoli.switch();
        zimoli();
    }
</script>